{
  "name": "ai-assistant-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "generate-api": "openapi-generator-cli generate -i openapi_spec.json -g typescript-axios -o src/generated/api --additional-properties=npmName=ai-assistant-api-client,supportsES6=true,withInterfaces=true",
    "clean": "rm -rf .next out src/generated",
    "test": "echo \"No tests specified\" && exit 0",
    "test:watch": "echo \"No tests specified\" && exit 0",
    "dev:dxc": "copy .env.dxc .env.local && next dev",
    "dev:dpac": "copy .env.dpac .env.local && next dev",
    "build:dxc": "copy .env.dxc .env.local && next build",
    "build:dpac": "copy .env.dpac .env.local && next build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.4",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@supabase/supabase-js": "^2.58.0",
    "ai": "^5.0.7",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.537.0",
    "minio": "^8.0.6",
    "next": "^15.4.6",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@openapitools/openapi-generator-cli": "^2.21.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2"
  }
}
